# Copy this file to .env and fill in the values below.
# cp .env.example .env

# --- Anthropic ---

# Required. API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional. Claude model used for all judgment calls in the pipeline.
CLAUDE_MODEL=claude-sonnet-4-6

# --- Google OAuth (Drive + Docs) ---

# Required. From a Google Cloud OAuth client ID (Desktop app type).
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Required. From the same OAuth client ID.
GOOGLE_CLIENT_SECRET=your-client-secret

# Optional. Where the cached OAuth refresh token is stored after first login.
# This file is created automatically -- do not create it by hand, and never commit it.
GOOGLE_TOKEN_PATH=token.json

# Optional. Local redirect URI used during the OAuth consent flow.
GOOGLE_REDIRECT_URI=http://localhost:8765/

# --- Pipeline behavior ---

# Optional. Top-level Drive folder name the pipeline looks for.
WORKING_FOLDER_NAME=2026 Recruiting

# Optional. Max edit/score loop iterations before stopping regardless of score.
MAX_ITER=5

# Optional. Coverage score (0-1) at which the edit loop stops early.
SCORE_THRESHOLD=0.85

# Optional. Cap on proposed edits per loop iteration.
MAX_EDITS_PER_ITERATION=4

# Optional. Max fraction the tailored resume's total character count may grow
# past the original base resume's length (keeps the resume to one page).
MAX_LENGTH_GROWTH=0.05
